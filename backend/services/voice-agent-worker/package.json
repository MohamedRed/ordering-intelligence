    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "c8": "^10.1.3",
    "tsx": "^4.7.3",
    "typescript": "^5.6.3"
  },
  "c8": {
    "check-coverage": true,
