{
  "displayName": "Telephony Adapter Overview (${environment})",
  "gridLayout": {
    "columns": "2",
    "widgets": [
      {
        "title": "Cloud Run 5xx Rate",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "legendTemplate": "5xx",
              "targetAxis": "Y1",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"${service_name}\" metric.label.\"response_code_class\"=\"5xx\"",
                  "aggregation": {
                    "perSeriesAligner": "ALIGN_DELTA",
                    "alignmentPeriod": "300s"
                  }
                }
              }
            }
          ],
          "yAxis": {
            "label": "Requests/min",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Request Latency P95",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "targetAxis": "Y1",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"${service_name}\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_PERCENTILE_95"
                  }
                }
              }
            }
          ],
          "yAxis": {
            "label": "Milliseconds",
            "scale": "LINEAR"
          }
        }
      }
    ]
  }
}
