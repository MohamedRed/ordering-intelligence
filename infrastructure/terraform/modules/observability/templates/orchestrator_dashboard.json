{
  "displayName": "Conversation Orchestrator Overview (${environment})",
  "gridLayout": {
    "columns": "2",
    "widgets": [
      {
        "title": "Request Volume",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "STACKED_AREA",
              "targetAxis": "Y1",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"${service_name}\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_RATE"
                  }
                }
              }
            }
          ],
          "yAxis": {
            "label": "Requests/min",
            "scale": "LINEAR"
          }
        }
      },
      {
        "title": "Error Rate",
        "xyChart": {
          "dataSets": [
            {
              "plotType": "LINE",
              "targetAxis": "Y1",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"${service_name}\" metric.label.\"response_code_class\"=\"5xx\"",
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_DELTA"
                  }
                }
              }
            }
          ],
          "yAxis": {
            "label": "5xx/min",
            "scale": "LINEAR"
          }
        }
      }
    ]
  }
}
