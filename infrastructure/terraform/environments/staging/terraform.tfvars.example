project_id      = "ordering-intelligence-ENV"
region          = "us-central1"
billing_account = ""
custom_domain_base = ""
enable_cloud_dns = false

admin_service_cors_origins = [
  "https://staging-admin.example.com",
  "https://staging-business.example.com",
]

agent_customization_cors_origins = [
  "https://staging-admin.example.com",
  "https://staging-business.example.com",
]

onboarding_cors_origins = [
  "https://staging-admin.example.com",
  "https://staging-business.example.com",
  "https://staging-driver.example.com",
]

notification_service_cors_origins = [
  "https://staging-admin.example.com",
  "https://staging-business.example.com",
  "https://staging-consumer.example.com",
  "https://staging-driver.example.com",
]

dispatch_service_cors_origins = [
  "https://staging-admin.example.com",
  "https://staging-business.example.com",
  "https://staging-consumer.example.com",
  "https://staging-driver.example.com",
]

delivery_service_cors_origins = [
  "https://staging-admin.example.com",
  "https://staging-business.example.com",
  "https://staging-consumer.example.com",
  "https://staging-driver.example.com",
]

channel_gateway_cors_origins = [
  "https://staging-consumer.example.com",
  "https://staging-telegram.example.com",
]

# Optional Cloud Run tuning (per service)
# cloud_run_overrides = {
#   order_service = {
#     min_scale = 1
#     env_overrides = {
#       PUBSUB_TOPIC_ORDERS = "custom-topic"
#     }
#   }
# }

order_service_lb_hostname = "staging-order-service.liive.app"
order_service_lb_certificate_mode = "MANAGED"
order_service_lb_managed_domains = ["staging-order-service.liive.app"]
