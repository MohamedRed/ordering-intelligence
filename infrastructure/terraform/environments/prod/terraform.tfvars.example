project_id      = "ordering-intelligence-ENV"
region          = "us-central1"
billing_account = ""
custom_domain_base = ""
enable_cloud_dns = false

admin_service_cors_origins = [
  "https://admin.example.com",
  "https://business.example.com",
]

agent_customization_cors_origins = [
  "https://admin.example.com",
  "https://business.example.com",
]

onboarding_cors_origins = [
  "https://admin.example.com",
  "https://business.example.com",
  "https://driver.example.com",
]

channel_gateway_cors_origins = [
  "https://consumer.example.com",
  "https://telegram.example.com",
]

order_service_lb_hostname         = "order-service.liive.app"
order_service_lb_certificate_mode = "MANAGED"
order_service_lb_managed_domains  = ["order-service.liive.app"]

# Optional Cloud Run tuning (per service)
# cloud_run_overrides = {
#   order_service = {
#     container_concurrency = 20
#     timeout_seconds       = 120
#   }
# }
